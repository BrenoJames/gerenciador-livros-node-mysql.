<div id="book-page">
    <a href="/books">Voltar para a lista</a>
    <div class="container">
        <h1>Livro: {{book.title}}</h1> 
        <p>Este livro tem <strong>{{book.pageqty}}</strong> páginas.</p>
        
        <div class="actions">
            <!-- Corrigido para singular: book.id -->
            <a href="/books/edit/{{book.id}}">Editar</a>
            
            <!-- Corrigido a rota: /books/ -->
            <form action="/books/remove/{{book.id}}" method="POST">
                <!-- Adicionei a class="btn-delete" aqui -->
                    <input type="submit" value="Remover" class="btn-delete">

            </form>
        </div>
        
        <span>Código do registro: #{{book.id}}</span>
    </div>
</div>
