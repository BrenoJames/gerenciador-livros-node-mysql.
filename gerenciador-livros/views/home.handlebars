<form action="/books/insertbook" method="POST" class="form"> 
    <div class="form-control"> 
        <label for="title">Título do Livro</label>
        <input type="text" name="title" placeholder="Ex: O Senhor dos Anéis" required>
    </div>

    <div class="form-control"> 
        <label for="pageqty">Número de páginas</label>
        <input type="number" name="pageqty" placeholder="Ex: 400" required>
    </div>
    
    <input type="submit" value="Cadastrar Livro">
</form>
